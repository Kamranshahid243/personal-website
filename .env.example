# Copy to `.env.local` and fill in. Parsed and validated by `src/env.ts`.
# Anything not prefixed with NEXT_PUBLIC_ stays on the server.

# Canonical origin. Drives metadataBase, sitemap.xml, robots.txt and OG URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Optional integrations -------------------------------------------------

# Transactional email for the contact form (https://resend.com).
# RESEND_API_KEY=""
# CONTACT_TO_EMAIL=""

# Spam protection for the contact form.
# TURNSTILE_SECRET_KEY=""
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
